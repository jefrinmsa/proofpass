{
  "name": "aadhaar-zk-auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @zk-auth/shared && npm run build -w @zk-auth/sdk && npm run build -w @zk-auth/api && npm run build -w @zk-auth/demo-a && npm run build -w @zk-auth/demo-b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "contracts:compile": "hardhat compile",
    "contracts:test": "npm run student:validate && hardhat test",
    "chain": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.cjs --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy.cjs --network sepolia",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:local": "pglite-server --db=.local/postgres --host=127.0.0.1 --port=5433 --max-connections=16",
    "db:cleanup": "tsx scripts/cleanup.ts",
    "configure:local": "tsx scripts/configure-local.ts",
    "test:browser": "playwright test",
    "app:register": "tsx scripts/register-app.ts",
    "keys:generate": "tsx scripts/generate-keys.ts",
    "dev:api": "tsx --env-file=.env apps/api/src/index.ts",
    "dev:a": "npm run dev -w @zk-auth/demo-a",
    "dev:b": "npm run dev -w @zk-auth/demo-b",
    "fixtures:generate": "tsx scripts/generate-fixtures.ts",
    "artifacts:fetch": "tsx scripts/fetch-artifacts.ts",
    "proof:validate": "tsx scripts/validate-proof.ts",
    "format": "prettier --write **/*.{ts,tsx,cjs,mjs,json,css,md,yaml}",
    "student:setup": "node scripts/setup-student.cjs",
    "student:deploy": "hardhat run scripts/deploy-student.cjs --network localhost",
    "student:configure": "tsx scripts/student-admin.ts configure",
    "student:seed": "tsx scripts/student-admin.ts seed",
    "student:mail": "tsx scripts/student-admin.ts mail",
    "student:revoke": "tsx scripts/student-admin.ts revoke",
    "student:ocr": "tsx scripts/setup-ocr.ts",
    "student:card": "tsx scripts/generate-student-card.ts",
    "student:validate": "tsx scripts/validate-student.ts",
    "student:activate": "tsx scripts/student-admin.ts activate",
    "student:email": "tsx scripts/student-admin.ts email",
    "student:mail:check": "tsx scripts/check-mail.ts",
    "student:deploy:sepolia": "hardhat run scripts/deploy-student.cjs --network sepolia",
    "student:sync": "tsx scripts/student-admin.ts sync",
    "assets:upload": "tsx scripts/upload-cloud-assets.ts",
    "build:vercel:lab": "node scripts/build-vercel.cjs demo-a",
    "build:vercel:library": "node scripts/build-vercel.cjs demo-b",
    "build:vercel:api": "node scripts/build-vercel.cjs api",
    "cloud": "tsx scripts/cloud.ts"
  },
  "dependencies": {
    "@anon-aadhaar/contracts": "2.4.3",
    "@anon-aadhaar/core": "2.4.3",
    "@fastify/cors": "10.0.2",
    "@fastify/rate-limit": "10.2.1",
    "@tanstack/react-query": "5.66.9",
    "@vercel/functions": "3.10.3",
    "circomlibjs": "0.1.7",
    "dotenv": "16.4.7",
    "fastify": "5.2.1",
    "jose": "5.10.0",
    "jsqr": "1.4.0",
    "next": "15.5.28",
    "nodemailer": "10.1.2",
    "pg": "8.13.3",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "snarkjs": "0.7.6",
    "tesseract.js": "7.0.0",
    "viem": "2.23.5",
    "wagmi": "2.14.11",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@electric-sql/pglite-socket": "0.2.13",
    "@nomicfoundation/hardhat-ethers": "3.0.8",
    "@playwright/test": "1.58.2",
    "@types/json-bigint": "1.0.4",
    "@types/node": "22.13.4",
    "@types/nodemailer": "8.0.2",
    "@types/pako": "2.0.3",
    "@types/pg": "8.11.11",
    "@types/qrcode": "1.5.5",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@types/uuid": "9.0.8",
    "circom2": "0.2.23",
    "circomlib": "2.0.5",
    "ethers": "6.13.5",
    "hardhat": "2.26.3",
    "prettier": "3.5.3",
    "solc": "0.8.28",
    "tsup": "8.5.0",
    "tsx": "4.19.3",
    "typescript": "5.7.3",
    "vitest": "3.0.6"
  }
}
